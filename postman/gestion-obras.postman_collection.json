              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/terrenos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "terrenos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lote creado', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const lote = pm.response.json();",
                  "  pm.collectionVariables.set('id_lote', String(lote.id_lote));",
                  "  pm.collectionVariables.set('id_direccion', String(lote.id_direccion));",
                  "  if (lote.mensuras && lote.mensuras.length) pm.collectionVariables.set('id_mensura_lote', String(lote.mensuras[0].id_documento));",
                  "}"
                ]
              }
