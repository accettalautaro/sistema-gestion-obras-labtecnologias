  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login - guarda el token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"{{dni}}\",\n  \"nombre\": \"{{contrasena}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Autentica con un usuario ya registrado en PostgreSQL. La API devuelve `{ token, rol }`; el script guarda `token` para las demás solicitudes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token', data.token);",
                  "  pm.collectionVariables.set('rol', data.rol);",
                  "  pm.test('La respuesta contiene un token', function () { pm.expect(data.token).to.be.a('string').and.not.empty; });",
                  "}"
                ]
              }
            }
          ],
          "auth": { "type": "noauth" }
        },
        {
          "name": "Perfil - verifica el token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/perfil",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "perfil"]
            }
          }
        }
      ]
    },
